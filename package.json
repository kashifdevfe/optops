{
  "name": "islamabadoptics",
  "private": true,
  "version": "1.0.0",
  "description": "OptOps — optics POS/admin + ecommerce (backend, dashboard, storefront)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm install --prefix frontend-ecommerce",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:ecommerce": "npm run dev --prefix frontend-ecommerce",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "prisma:seed": "npm run prisma:seed --prefix backend",
    "prisma:studio": "npm run prisma:studio --prefix backend"
  }
}
