# Copy this file to .env (optional for local dev):
#   copy .env.example .env
#
# Leave VITE_API_URL unset to use the Vite proxy (/api -> http://localhost:5000).
# Ecommerce API paths already include /ecommerce when using the proxy.
# Only set this if you want to hit the backend directly:
# VITE_API_URL=http://localhost:5000/api/ecommerce
