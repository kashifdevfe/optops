# Copy this file to .env and fill in values:
#   copy .env.example .env

# PostgreSQL connection string
# Local example:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/islamabadoptics?schema=public"
# Prisma Accelerate (shared team DB) — ask a teammate for the URL:
#   DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/islamabadoptics?schema=public"

PORT=5000
NODE_ENV=development

# Generate strong random strings for local use (any long random value is fine)
JWT_SECRET=change-me-local-jwt-secret
JWT_REFRESH_SECRET=change-me-local-jwt-refresh-secret
SESSION_SECRET=change-me-local-session-secret

# Allowed frontend origins (defaults work for local Vite apps)
FRONTEND_URL=http://localhost:5173
FRONTEND_ECOMMERCE_URL=http://localhost:3001

# Optional — password reset / emails (leave blank if you don't need email locally)
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=noreply@example.com
